PORT=3000
HOST=0.0.0.0
# demo: local, persistent sample dataset; supabase: real Supabase Auth/PostgreSQL
DATA_MODE=demo
DEMO_DATA_FILE=./data/demo.json
BOOKING_TIMEZONE=Europe/Istanbul
# Browser origins only; native Android requests do not send Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Required only with DATA_MODE=supabase. Never use a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
